# ============================================================================
# Luciteria Collector Cabinet — Environment Variables (example)
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# ============================================================================

# ─── APP MODE ───────────────────────────────────────────────────────────────
# "prototype" uses mock Shopify calls and bypasses webhook HMAC checks (local
# dev/testing). "production" enforces real credentials + signature validation.
APP_MODE=prototype
NODE_ENV=development

# ─── DATABASE (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/luciteria_cabinet

# ─── SESSION ────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_SECRET=change-me-to-a-different-long-random-string

# ─── PUBLIC URL ─────────────────────────────────────────────────────────────
# Public base URL of the Cabinet app; used when registering webhook callbacks.
CABINET_BASE_URL=https://cabinet.luciteria.com
APP_URL=https://cabinet.luciteria.com

# ─── SHOPIFY ────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2024-10
SCOPES=read_products,read_customers,write_draft_orders

# ─── SEAL SUBSCRIPTIONS (subscription billing) ──────────────────────────────
# Find these in the Shopify admin:
#   Seal Subscriptions app → Settings → General settings → API
# SEAL_API_TOKEN  = the shop API token, sent as the "X-Seal-Token" header.
# SEAL_API_SECRET = the shop API secret, used to verify inbound webhook HMAC
#                   signatures (base64 HMAC-SHA256 of the raw body) delivered
#                   in the "X-Seal-Hmac-Sha256" header.
SEAL_API_TOKEN=
SEAL_API_SECRET=
# Optional overrides (defaults shown):
SEAL_API_BASE_URL=https://app.sealsubscriptions.com/shopify/merchant/api
SEAL_SIGNATURE_HEADER=x-seal-hmac-sha256
SEAL_TOPIC_HEADER=x-seal-topic
SEAL_SIGNATURE_ENCODING=base64

# ─── EMAIL / NOTIFICATIONS ──────────────────────────────────────────────────
EMAIL_SERVICE_PROVIDER=none
EMAIL_SERVICE_API_KEY=
EMAIL_FROM_ADDRESS=noreply@luciteria.com
EMAIL_FROM_NAME=Luciteria
RESEND_API_KEY=

# ─── FEATURE FLAGS ──────────────────────────────────────────────────────────
FEATURE_ASSIGNMENT_ENGINE=true
FEATURE_DISCOUNT_ALERTS=true
FEATURE_PRECIOUS_METAL_EXCLUSION=true
FEATURE_GRANDFATHERING=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_WEBHOOK_SYNC=false
FEATURE_MULTI_COLLECTION=false

# ─── PRICING DEFAULTS (fallbacks; canonical price comes from the tier/webhook) ─
PRICE_10MM_MONTHLY=49.99
PRICE_25MM_MONTHLY=69.99
PRICE_50MM_MONTHLY=99.99
PRICE_LUCITE_MONTHLY=79.99
PRICE_AMPOULES_MONTHLY=59.99

# ─── DISCOUNT THRESHOLDS ────────────────────────────────────────────────────
DISCOUNT_ALERT_THRESHOLD=0.20
DISCOUNT_HARD_CAP=0.35
GRANDFATHER_DEFAULT_MONTHS=12

# ─── LOGGING ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text

# ─── AVATAR / FILE STORAGE (Vercel Blob) ────────────────────────────────────
# Collector avatar uploads are stored in Vercel Blob so they persist across
# deploys (the Vercel serverless filesystem is read-only and ephemeral).
# Create a Blob store in the Vercel dashboard (Storage > Blob) and connect it
# to this project — Vercel then injects BLOB_READ_WRITE_TOKEN automatically.
# For local development you may leave this empty (files fall back to
# public/avatars/); it is REQUIRED in production for avatar uploads to work.
BLOB_READ_WRITE_TOKEN=

# ─── CRON / SCHEDULED JOBS ──────────────────────────────────────────────────
# Shared secret for protecting the /api/cron endpoint from unauthorized calls.
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" (GET); external
# schedulers may instead send "X-Cron-Secret: <CRON_SECRET>". The endpoint accepts
# either. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret-here

# ─── ANALYTICS ──────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Find this in your GA4 property settings: Admin > Data Streams > Web > Measurement ID
# Leave empty to disable GA tracking
GA_MEASUREMENT_ID=
